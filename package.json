  },
  "license": "MIT",
  "homepage": "https://github.com/whajqqbqkwjuw-oss/kaisha-fca#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whajqqbqkwjuw-oss/kaisha-fca.git"
  },
  "bugs": {
    "url": "https://github.com/whajqqbqkwjuw-oss/kaisha-fca/issues"
  },
  "engines": {
    "node": "26.7.0"
  },
  "dependencies": {
